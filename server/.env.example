# Copy to .env and adjust. Never commit the real file.
NODE_ENV=development
PORT=4000

# Local Mongo, or an Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/wyzetalk_helpdesk

# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN_SECONDS=86400

# Comma-separated list of allowed browser origins (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# Seed script credentials (used by `pnpm seed`).
SEED_ADMIN_EMAIL=admin@wyzetalk.test
SEED_ADMIN_PASSWORD=Admin123!
