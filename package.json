{
  "name": "wyzetalk-helpdesk",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @wyzetalk/db build && pnpm --filter @wyzetalk/api build && pnpm --filter @wyzetalk/web build",
    "build:api": "pnpm --filter @wyzetalk/api build",
    "build:web": "pnpm --filter @wyzetalk/web build",
    "clean": "pnpm -r exec rm -rf dist",
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @wyzetalk/api dev",
    "dev:web": "pnpm --filter @wyzetalk/web dev",
    "seed": "pnpm --filter @wyzetalk/api seed",
    "start:api": "pnpm --filter @wyzetalk/api start",
    "start:web": "pnpm --filter @wyzetalk/web start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
