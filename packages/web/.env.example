# Copy to .env.local to point the app at an API that is not the dev proxy.
# Leave unset in development: requests go to /api/v1 and Vite proxies them.
# VITE_API_BASE_URL=http://localhost:4000/api/v1

# Where the dev server forwards /api during `pnpm dev`.
VITE_API_PROXY_TARGET=http://localhost:4000
