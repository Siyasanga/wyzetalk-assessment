{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "inputs": [
        "...",
        {
          "local": true,
          "include": [
            "pnpm-workspace.yaml",
            "packages/api/package.json",
            "packages/db/package.json",
            "packages/web/package.json"
          ]
        }
      ]
    },
    "build": {
      "commands": ["pnpm --filter @wyzetalk/db build", "pnpm --filter @wyzetalk/api build"]
    }
  },
  "deploy": {
    "startCommand": "pnpm --filter @wyzetalk/api start"
  }
}
